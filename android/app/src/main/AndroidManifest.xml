<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- v2.14.27: 闹钟接收器，由 AlarmManager.setExactAndAllowWhileIdle 在用户「定时提醒」
             到点时触发。Receiver 不再直接 post 通知或拉起来电界面 (v2.14.24-26 那一套已删)，
             改成 silent activity 唤醒 + startForegroundService(KumikoAlarmGuardianService,
             ACTION_REMINDER_DISPATCH)。MainActivity 收到 EXTRA_REMINDER_FIRED 后通过
             KumikoAlarmsPlugin.notifyAlarmFired bridge 到 JS 端 kumikoAlarmFired 事件，
             JS 端 useScheduledReminders 跑 LLM 生成 + 通过 LocalNotifications 发最终通知。
             exported=false 因为只接收 PendingIntent 自发的 alarm，不公开。 -->
        <receiver
            android:name=".alarms.KumikoAlarmReceiver"
            android:exported="false" />

        <!-- v2.14.23: BootReceiver 重启后从 SharedPreferences ledger 重建所有 pending alarm。
             Android 在 BOOT_COMPLETED / LOCKED_BOOT_COMPLETED / MY_PACKAGE_REPLACED /
             QUICKBOOT_POWERON 之后会清空所有 AlarmManager 注册，没有这个 receiver 就等于
             用户重启手机后所有定时提醒都消失。directBootAware=true 让我们在 FBE 设备上
             Locked Boot 阶段就能跑（早于用户解锁），唯一访问的存储是 device-protected SharedPreferences。
             exported=true 因为这些 broadcast 来自 system 进程。 -->
        <receiver
            android:name=".alarms.KumikoBootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- B.4: Direct Reply 接收器，处理通知 RemoteInput 锁屏直回。Android 7+ RemoteInput 走
             这条路：用户在通知栏输入文字 → broadcast 到这里 → 注入到 store messages 队列 →
             WebView 收到后走 chatActions 同款回放路径。
             exported=true 因为 NotificationManager 从 system 进程发 PendingIntent 进来。 -->
        <receiver
            android:name=".replies.RemoteReplyReceiver"
            android:exported="true" />

        <!-- B.1: @capawesome-team/capacitor-android-foreground-service 的 manifest 块。
             Service 用于 host 一个常驻通知让进程不被 Android 后台杀掉，
             这样 useProactiveLifeCycle 的 RNG 主动消息 / 睡眠协议 / Busy 跟进 /
             B.5 自动备份 4h 定时器在锁屏 / app 关闭后还能跑。
             foregroundServiceType="dataSync" 因为我们的工作是「同步 / 处理本地数据 + 偶发推送」，
             这是 Android 14+ 上数据类后台任务的官方分类。 -->
        <receiver android:name="io.capawesome.capacitorjs.plugins.foregroundservice.NotificationActionBroadcastReceiver" />
        <service
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.AndroidForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- v2.14.23: 提醒守护前台服务。foregroundServiceType="specialUse" + subtype "alarm"
             让我们的进程优先级在用户设置过提醒时一直保持 foreground 级别，激进 ROM
             (MIUI/HyperOS, EMUI/HarmonyOS, OneUI deep sleep) 上能显著降低被杀概率。
             v2.14.27 起还承担「短时 reminder dispatch 保活」职责：receiver 收到 alarm 后
             会以 ACTION_REMINDER_DISPATCH 启动本服务，临时升级通知文案为「正在准备提醒…」
             并保活 30 s，让 JS 端 LLM 生成跑完。Android 14+ 强制要求 PROPERTY_SPECIAL_USE_FGS_SUBTYPE
             声明 + 一段说明文本。 -->
        <service
            android:name=".alarms.KumikoAlarmGuardianService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- 网络（拉云端 LLM / TTS / 历史天气 / RAG embedding API） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 触觉反馈：Haptics 插件 + LINE/微信式短脉冲 / 来电长震动模式 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- WAKE_LOCK：语音播放 / 通话期间防止 CPU 休眠（与 useAppViewport 里的 wakeLock 同源；
         Foreground Service 也需要它在 Doze 模式下完成短暂的 CPU 工作，AlarmReceiver 在被
         alarm 唤醒后用 PowerManager.WakeLock 短锁住 CPU 直到我们把 silent activity wake
         + FGS 启动完成。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- B.1 Foreground Service（A6.1）。Android 14 起需要声明 type；我们用 dataSync 因为
         主要工作是 4h 自动备份 + 主动消息检测（不是 mediaPlayback / location / 等专项类）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- v2.14.23 提醒守护前台服务。Android 14+ 上 specialUse 子类型必须额外声明这个 permission，
         否则 startForeground 会抛 SecurityException。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- B.2 通知（Android 13 起 POST_NOTIFICATIONS 是运行时权限，
         系统会弹一次授权弹窗。capacitor-local-notifications + capacitor-android-foreground-service
         都依赖这个。Android 12 及以下自动授予。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- B.2 AlarmManager 精确闹钟（Android 12+）。SCHEDULE_EXACT_ALARM 是用户可在系统设置里
         撤销的特殊权限；USE_EXACT_ALARM 不可撤销但只允许「日历 / 闹钟类」app 使用。
         我们两个都申报：Android 13+ Play Store 风险评估上 USE_EXACT_ALARM 必须有合理用途
         （定时提醒 = 用户主动设置的提醒，符合定义）；SCHEDULE_EXACT_ALARM 作为 fallback。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- B.3 全屏来电。Android 14+ 必须申报；普通 app 第一次会弹一个授权请求把通知降级为
         heads-up。我们的「定时提醒到点拉起的 AI 来电」是合理使用场景之一。v2.14.27 起
         由 LocalNotifications 在 JS 侧 schedule 时使用，本地不再直接 post CallStyle。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- B.1 启动屏幕开机自启动（仅在用户开了"开机自启"开关时生效）。FG service 用它在重启后
         自动恢复，否则用户重启手机后 4h 自动备份循环就断了。
         v2.14.23: KumikoBootReceiver 也吃这个 broadcast，重启后从 ledger 重建所有 alarm。-->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- v2.14.27: 电池优化白名单。REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 不是真的 grant，
         而是允许我们调起系统的「申请加入 battery whitelist」弹窗。AndroidPermissionsSection 通过
         KumikoAlarmsPlugin.openSettings({key:'batteryOptimization'}) 调用它。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

</manifest>
