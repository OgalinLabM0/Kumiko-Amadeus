public/images/emotions/*.png
public/ringtones/*.mp3
public/sovits-ref/*.wav
public/sovits-ref/*.txt
public/images/logo.png
public/CCA-P2.png
public/favicon-KA.ico
assets/worldbook.enc
assets/lore.enc
services/loreData.ts
story-notes.md
