migrated_prompt_history
models/bge-m3-onnx/*.onnx

# Editor directories and files
.vscode/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor iOS (Pods 由 CocoaPods 生成；ios/ 工程本身应提交以便无 Mac 成员同步)
ios/App/Pods
ios/App/build
ios/**/DerivedData

# v2.14.4 H.4: Android 发布签名 keystore（极度敏感，泄漏 = 失去应用身份证）
# 详细配置见 docs/android-keystore-setup.md。CI 通过 GitHub Secret 注入，
# 任何写到工作树里的拷贝（包括解码出的 release.keystore、临时的
# keystore.b64、或者人手放进 android/app/ 调试用的 *.jks）都不能进 git。
*.keystore
*.jks
keystore.b64
android/app/release.keystore
android/app/upload-keystore.jks

# Capacitor Android（Gradle 构建产物 / 本机 SDK 路径 / IDE 文件不入仓）
# android/ 工程本身要提交，让 GitHub Actions / 协作者无须重新跑 cap add
android/.gradle/
android/.kotlin/
android/build/
android/captures/
android/local.properties
android/app/build/
android/app/release/
android/app/debug/
android/app/google-services.json
android/.idea/
android/*.iml
android/app/*.iml
# Capacitor 同步出来的中间产物（每次 cap sync 重新生成）
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
# CMake / NDK 缓存（A5 sqlite-vec 跨编时会用到）
android/.cxx/
android/app/.cxx/
android/.externalNativeBuild/
android/app/.externalNativeBuild/

# Character-specific copyrighted assets (distributed separately via kumiko-assets.zip)
