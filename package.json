{
  "name": "kumiko-ai-amadeus",
  "private": true,
  "version": "2.14.0",
  "description": "Kumiko Amadeus desktop companion focused on long-term memory and natural character interaction.",
  "author": "Kitauji Fan Project",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:3000 && electron .\"",
    "desktop:build": "npm run build:cap && npm run release:clean:prebuild && electron-builder && npm run release:latest-yml && npm run release:assets && npm run release:clean:postbuild",
    "release:assets": "node scripts/package-assets.cjs",
    "fetch-assets": "node scripts/fetch-assets.cjs",
    "check-assets": "node scripts/check-assets-drift.cjs",
    "build:pwa-icons": "node scripts/build-pwa-icons.cjs",
    "build:android-icons": "node scripts/build-android-icons.cjs",
    "android:strip-pc-only": "node scripts/strip-android-only-assets.cjs",
    "dev": "vite",
    "prebuild": "node scripts/build-pwa-icons.cjs",
    "build": "vite build",
    "build:cap": "vite build --base ./",
    "build:lore": "node scripts/build-lore.cjs",
    "release:latest-yml": "node scripts/generate-latest-yml.cjs",
    "cap:sync": "npm run build:cap && npx cap sync ios",
    "cap:sync:android": "npm run build:cap && npm run android:strip-pc-only && npm run build:android-icons && npx cap sync android",
    "verify:android": "npm run build:cap && npm run android:strip-pc-only && npm run build:android-icons && npx cap copy android && npx cap update android",
    "verify:both": "npm run verify:android && npx cap copy ios && npx cap update ios",
    "preview": "vite preview",
    "release:clean:prebuild": "node scripts/clean-release.cjs prebuild",
    "release:clean:postbuild": "node scripts/clean-release.cjs postbuild"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.2",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "@capawesome-team/capacitor-android-foreground-service": "^7.0.1",
    "@google/genai": "^1.31.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.8.0",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.3",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.0.0",
    "hnswlib-node": "^3.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "onnxruntime-node": "^1.24.3",
    "onnxruntime-web": "^1.14.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  },
  "optionalDependencies": {
    "@img/sharp-linux-arm64": "0.34.5",
    "@img/sharp-linux-x64": "0.34.5",
    "@img/sharp-win32-arm64": "^0.34.5",
    "@img/sharp-win32-x64": "0.34.5"
  },
  "overrides": {
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.kumiko.ai",
    "productName": "Kumiko·Amadeus",
    "executableName": "Kumiko-Amadeus",
    "publish": [
      {
        "provider": "github",
        "owner": "OgalinLabM0",
        "repo": "Kumiko-Amadeus",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "Kumiko-Amadeus-Setup-${arch}-${version}.exe",
      "differentialPackage": false,
      "uninstallDisplayName": "Kumiko·Amadeus",
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/favicon-KA.ico",
      "uninstallerIcon": "public/favicon-KA.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/sovits-ref/**",
      "electron-main.cjs",
      "preload.cjs",
      "electron-rag.cjs",
      "rag-worker.cjs",
      "electron/**/*",
      "services/ragRebuildCore.js",
      "public/**/*",
      "!public/sovits-ref/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/hnswlib-node/**"
    ],
    "extraResources": [
      {
        "from": "models/bge-m3-onnx",
        "to": "models/bge-m3-onnx",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/onnxruntime-web/dist",
        "to": "onnxruntime-web-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/favicon-KA.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/favicon-KA.png",
      "category": "Utility",
      "synopsis": "Long-term memory desktop companion for natural character interaction.",
      "description": "Kumiko·Amadeus is a desktop AI companion focused on long-term memory and natural character interaction. Supports optional GPT-SoVITS with your own Python runtime.",
      "executableName": "Kumiko-Amadeus",
      "artifactName": "Kumiko-Amadeus-${arch}.AppImage",
      "desktop": {
        "entry": {
          "Name": "Kumiko-Amadeus",
          "GenericName": "AI Companion",
          "Comment": "Kumiko·Amadeus desktop companion",
          "StartupWMClass": "Kumiko-Amadeus",
          "Keywords": "chat;ai;companion;memory;kumiko;amadeus;"
        }
      }
    }
  }
}
